# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB (system of record for IF rolling window) ────────────────────────
# prd.md §FR-2: MongoDB stores last 20 min of readings; cleared after each retrain
MONGO_URI=mongodb://localhost:27017/smartconveyor_shield

# ─── Firebase / Firestore (real-time ingest source, prd.md §FR-1) ────────────
# Set these to your actual Firebase project credentials.
# ASSUMPTION: Firestore is reachable at least intermittently (prd.md §Assumptions)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── YOLOv8 (prd.md §FR-3) ───────────────────────────────────────────────────
# Python inference microservice URL — run separately (e.g. FastAPI wrapping ultralytics)
# PLACEHOLDER: wire real endpoint when model is deployed
YOLO_ENDPOINT=http://localhost:8000/detect

# ─── Pinecone + LangChain (prd.md §FR-6) ────────────────────────────────────
# PLACEHOLDER: configure when Pinecone index and LangChain pipeline are set up
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=smartconveyor-rag
PINECONE_ENV=us-east-1-aws
OPENAI_API_KEY=your-openai-api-key
LANGCHAIN_TRACING_V2=false

# ─── Isolation Forest (prd.md §FR-2) ─────────────────────────────────────────
IF_RETRAIN_INTERVAL_MIN=20
IF_ROLLING_WINDOW_MIN=20

# ─── Network resilience (prd.md §Open Questions) ──────────────────────────────
# ASSUMPTION: Firestore → MongoDB sync uses batched snapshots every IF_RETRAIN_INTERVAL_MIN
# MQTT support pending evaluation for low-bandwidth mine connectivity
MQTT_BROKER_URL=mqtt://localhost:1883
